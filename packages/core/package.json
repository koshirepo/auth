{
  "name": "@koshi-repo/auth-core",
  "version": "0.1.0",
  "description": "Shared types, errors and RBAC/ABAC policy evaluation for the auth library. No runtime dependencies.",
  "repository": {
    "type": "git",
    "url": "https://github.com/koshirepo/auth.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
