{
  "name": "@koshirepo/auth-client",
  "version": "0.2.0",
  "description": "Headless browser client for the auth library: session state, automatic refresh, device binding, MFA and passkey flows, route guards. No styling.",
  "repository": {
    "type": "git",
    "url": "https://github.com/koshirepo/auth.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@koshirepo/auth-core": "workspace:*",
    "jose": "^6.2.18"
  },
  "peerDependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@simplewebauthn/browser": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@koshirepo/auth-server": "workspace:*",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
